{
  "name": "@vclinks/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:connector": "node dist/connector.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --passWithNoTests --testRegex \"\\\\.spec\\\\.ts$\"",
    "token:create": "node dist/scripts/create-token.js",
    "encrypted:mark": "node dist/scripts/mark-encrypted.js",
    "encrypted:clean": "node dist/scripts/clean-encrypted.js",
    "migrate:tenant": "node dist/scripts/migrate-tenant.js",
    "kpi:baseline": "node dist/scripts/kpi-baseline.js",
    "measure:360": "node dist/scripts/measure-360.js",
    "migrate:customers": "node dist/scripts/migrate-customers.js",
    "security:reapply-erasures": "node dist/scripts/reapply-erasures.js",
    "test:e2e": "jest --runInBand --testRegex \"\\\\.e2e-spec\\\\.ts$\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@vclinks/shared": "workspace:*",
    "@vclinks/vcsale-client": "workspace:*",
    "exceljs": "^4",
    "express": "4.22.1",
    "js-yaml": "^5.4.2",
    "mongodb": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "testTimeout": 60000,
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
