# --- API ---
PORT=3000
MONGO_URI=mongodb://mongo:27017/vclinks
REDIS_URL=redis://redis:6379
TZ=Asia/Ho_Chi_Minh
# Origins allowed to call the REST API from a browser (dashboard dev server)
CORS_ORIGINS=http://localhost:5173

# --- MinIO (used from phase 2) ---
MINIO_ROOT_USER=vclinks
MINIO_ROOT_PASSWORD=change-me-please
# At-rest encryption for MinIO objects: "<key-name>:<base64 32-byte key>"
# Generate with: echo "vclinks-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=vclinks-key:REPLACE_WITH_BASE64_32_BYTES

# --- Multi-channel (API channels) ---
# Public HTTPS base URL of the dashboard/API (named Cloudflare tunnel or domain). Used for OAuth
# redirects and webhook URLs; a quick-tunnel URL changes on every restart, so webhooks need a fixed one.
PUBLIC_BASE_URL=https://vclinks.example.com
# Encrypts channel credentials (OA / Page tokens) at rest. Generate: openssl rand -base64 32
CREDENTIALS_KEY=REPLACE_WITH_BASE64_32_BYTES

# Per-customer encryption (M1b-14, docs/04-ky-thuat/api/muc-mat-va-khoa-theo-khach.md).
# Master key wrapping each customer's key; losing it makes encrypted messages unreadable. openssl rand -base64 32
CUSTOMER_KEK=
# 1 = encrypt message content at ingest (off until the search uses another index)
CUSTOMER_ENCRYPTION=0
# Erasure ledger database, backed up apart from the main database (default <db>_erasures)
ERASURE_LEDGER_DB=

# Facebook App (Messenger Platform, Fanpage)
FB_APP_ID=
FB_APP_SECRET=
# Any random string; entered in the Meta App webhook settings
FB_VERIFY_TOKEN=

# Zalo OA app (developers.zalo.me)
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
# Optional: webhook signing key if the OA Webhook page shows one different from the app secret
ZALO_OA_WEBHOOK_SECRET=

# --- Login (Google Workspace SSO, M1b-02) ---
# OAuth client of the Google Cloud project; values live only in .env, never in git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the API, used for the redirect URI <AUTH_BASE_URL>/api/auth/google/callback
AUTH_BASE_URL=
# Origin of the web app after login (empty = same as AUTH_BASE_URL; dev server: http://localhost:5173)
AUTH_WEB_URL=
# Password-less token login on the login page: on unless set to 0 or false
AUTH_TOKEN_LOGIN=1
# Email of the first Admin, read by `pnpm seed:td` (dev only)
SEED_ADMIN_EMAIL=

# --- Permissions (M1b-04) ---
# Old tokens without a user (scope dashboard) keep full access only when 1. Dev / test only; production: 0.
AUTHZ_LEGACY_TOKENS=0
# Org unit code of the division that owns channels with no division yet (owner decision: VCparts)
AUTHZ_DEFAULT_DIVISION=
# Real uid of the driver nick TD-NK01, read by `pnpm seed:org` to make TD-U-KD1 its holder (dev only)
SEED_NK01_UID=

# M1a-04: who friend commands (friend_accept / friend_reject / friend_request) may target:
# Zalo user ids or phone numbers, comma separated; `*` = everyone (owner's decision only).
# Empty or unset = every friend command is refused (400).
FRIEND_TARGETS=

# --- Customer model (M1b-12) ---
# VCsales client: mock (default, until API E5 exists) | http (needs VCSALE_URL, VCSALE_TOKEN; not implemented yet)
VCSALE_MODE=mock
VCSALE_URL=
VCSALE_TOKEN=
# Gửi báo giá (M1c-02): ánh xạ tay nhóm Zalo (chưa có hồ sơ khách) tới mã VCsales, ví dụ {"<uid>:<mã nhóm>":"KH-TEST-0101"}.
# Quyền vẫn lấy từ chủ của khách mang mã đó. Chỉ dùng cho nhóm test "Kiểm thử vclink".
QUOTE_THREAD_CUSTOMERS=
# Phiếu CSKH soạn – NVKD duyệt (M1c-03). Ngưỡng chờ chủ dự án chốt (E7): số lần trả lại T-36, nhắc người duyệt, báo giám sát (phút làm việc).
WORKITEM_MAX_RETURNS=2
WORKITEM_REMIND_MIN=10
WORKITEM_ESCALATE_MIN=20
# Quét nhắc / theo dõi lệnh gửi (ms); WORKITEM_JOBS=off để tắt. "AI trích nhu cầu" tắt tới khi bật M1c-06 (=1).
WORKITEM_SWEEP_MS=60000
WORKITEM_AI_EXTRACT=0
# Thời gian giữ cờ "Nợ quá hạn" của danh sách hội thoại (ms), mặc định 300000.
DEBT_FLAG_TTL_MS=300000
# Background sweep (profiles for new identities, D8-05 merges), in ms; 0 disables. Default 300000 (5 min).
CUSTOMERS_SWEEP_MS=300000
# Nhịp gửi theo nick (M1a-06, 03 SZ-04): tối thiểu ms giữa hai lệnh và tối đa lệnh mỗi phút.
# Giới hạn cứng 1000–600000 ms và 1–30 lệnh/phút; từng nick ghi đè qua PATCH /api/accounts/:uid { sendPace }.
SEND_PACE_GAP_MS=1500
SEND_PACE_PER_MINUTE=20

# --- Audit log addresses (M1b-17, L-03) ---
# Socket addresses allowed to set CF-Connecting-IP (cloudflared on this machine). Empty = header never trusted.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Days the client address is kept on audit lines (NĐ 13); at least 31 for rule R6. Sweep period in ms, 0 disables.
AUDIT_IP_RETENTION_DAYS=90
AUDIT_IP_SWEEP_MS=86400000
