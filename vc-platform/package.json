{
  "name": "vc-platform",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kc:local": "scripts/kc-local.sh",
    "realm:apply": "pnpm --filter @vc/realm-apply run apply --",
    "realm:apply:dev": "pnpm --filter @vc/realm-apply run apply -- --file ../realm/gia-google.yaml && pnpm --filter @vc/realm-apply run apply -- --file ../realm/vc.yaml --file ../realm/vc.dev.yaml",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "ci:local": "pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @vc/e2e test:e2e",
    "app-mau": "pnpm --filter @vc/app-mau start",
    "provisioner": "pnpm --filter @vc/provisioner start --",
    "home": "pnpm --filter @vc/home dev",
    "home:nginx": "pnpm --filter @vc/home build && home/scripts/nginx-local.sh"
  }
}
