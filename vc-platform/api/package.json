{
  "name": "@vc/api",
  "version": "0.1.0",
  "private": true,
  "description": "VC Home API (GĐ B–D): NestJS 10 + MongoDB replica set (khung chung mục 3–8)",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput >/dev/null & node --watch dist/main.js)",
    "job:run": "node dist/scripts/job-run.js",
    "migrate": "node dist/scripts/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@vc/contracts": "workspace:*",
    "express": "^4.21.0",
    "mongodb": "^6.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "typescript": "^5.6.0"
  },
  "files": [
    "dist"
  ]
}
