# Biến môi trường production của vc-platform. Chép thành .env trên máy chủ (quyền 600). KHÔNG đưa .env vào git.
# Máy dev và CI dùng scripts/dev-env.sh (giá trị giả).

# --- Keycloak (VC ID) ---
KC_URL=https://id.vcprosperous.com
KC_HOSTNAME=https://id.vcprosperous.com
KC_HOSTNAME_ADMIN=https://id-admin.vcprosperous.com
KC_ADMIN_USER=
KC_ADMIN_PASSWORD=
KC_DB_PASSWORD=
KC_SSL_REQUIRED=external

# --- Google (đầu vào I3: OAuth client "VC ID" trên Google Cloud) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Địa chỉ các app ---
VCHOME_URL=https://home.vcprosperous.com
VCLINKS_URL=https://vclink.tramaphutung.com
VCWIKI_URL=https://vcwiki.tramaphutung.com

# --- Bí mật client (sinh ngẫu nhiên ≥ 32 ký tự, xoay 6 tháng một lần) ---
VCLINKS_CLIENT_SECRET=
VCWIKI_CLIENT_SECRET=
PROVISIONER_CLIENT_SECRET=

# --- vc-provisioner (đầu vào I4: tài khoản dịch vụ đọc Directory) ---
GOOGLE_SA_KEY_FILE=/run/secrets/google-directory.json
GOOGLE_ADMIN_SUBJECT=
GOOGLE_WORKSPACES=vcprosperous.com,vcpart.vn
