# Biến môi trường production của vc-platform (compose.yml). Chép thành .env trên máy chủ, chmod 600.
# KHÔNG đưa .env, secrets/ vào git. Máy dev dùng scripts/dev-env.sh; chạy thử compose dùng scripts/local-prod.env.
# Bí mật sinh ngẫu nhiên: openssl rand -base64 36

# --- Tên miền (đầu vào I2) ---
KC_HOSTNAME=https://id.vcprosperous.com
KC_HOSTNAME_ADMIN=https://id-admin.vcprosperous.com
KC_PUBLIC_HOST=id.vcprosperous.com
KC_ADMIN_HOST=id-admin.vcprosperous.com
VCHOME_URL=https://home.vcprosperous.com
VCLINKS_URL=https://vclink.tramaphutung.com
VCWIKI_URL=https://vcwiki.tramaphutung.com
KC_SSL_REQUIRED=external

# --- Keycloak (VC ID) ---
KC_DB_PASSWORD=
# Client quản trị tạo ở lần khởi động đầu, dùng cho `docker compose run --rm realm-apply`.
KC_ADMIN_CLIENT_ID=vc-bootstrap
KC_ADMIN_CLIENT_SECRET=
# Ảnh gốc (quay.io hoặc keycloak/keycloak trên Docker Hub; cùng nhà phát hành)
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.5
# NODE_IMAGE=node:22-alpine

# --- Google (đầu vào I3: OAuth client "VC ID" trên Google Cloud) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Bí mật client của app (xoay 6 tháng một lần) ---
VCLINKS_CLIENT_SECRET=
VCWIKI_CLIENT_SECRET=
PROVISIONER_CLIENT_SECRET=
# VC Home API (GĐ B) gọi Admin API của VC ID
VCHOME_API_CLIENT_SECRET=

# --- vc-provisioner (đầu vào I4: khoá tài khoản dịch vụ đặt ở secrets/google-directory.json) ---
GOOGLE_ADMIN_SUBJECT=
GOOGLE_WORKSPACES=vcprosperous.com,vcpart.vn
COMPANY_DOMAINS=vcprosperous.com,vcpart.vn
DEFAULT_APP_GROUPS=app-vclinks,app-vcwiki
# Để trống tuần đầu (chỉ ghi log việc sẽ làm). Đặt apply sau khi chủ dự án duyệt báo cáo I9.
PROVISIONER_MODE=
PROVISIONER_INTERVAL_MIN=15

# --- VC Home ---
VCHOME_SUPPORT_EMAIL=it@vcprosperous.com

# --- Cảnh báo (Telegram qua webhook, hoặc dịch vụ nhận JSON {"text": "…"}) ---
ALERT_WEBHOOK_URL=

# --- Sao lưu ---
BACKUP_HOUR=2
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=6
# Nơi lưu ngoài máy theo rclone (cấu hình ở secrets/rclone.conf), ví dụ s3:vc-backup/vc-id. Trống: chỉ lưu trên máy.
BACKUP_RCLONE_REMOTE=
BACKUP_PATH=./backups

# --- Cloudflare tunnel (đầu vào I2): id., id-admin. → http://edge:8080; home. → http://home:8080 ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- VC Home API (GĐ B; thêm vào compose.yml ở phiên B-16) ---
# APP_ENV=production
# MONGO_URL=mongodb://vchome_api:<mật khẩu>@mongo:27017/?replicaSet=rs0&authSource=admin
# MONGO_DB=vchome
# OIDC_ISSUER=https://id.vcprosperous.com/realms/vc
# OIDC_AUDIENCE=vchome-api
# KC_ADMIN_CLIENT_ID=vc-home-api
# KC_ADMIN_CLIENT_SECRET=
# CLOCK_MODE=real
# Đơn vị gốc loại Tập đoàn, tạo một lần lúc khởi động đầu (migration B0005)
# ROOT_UNIT_CODE=VCPV
# ROOT_UNIT_NAME=Tập đoàn VC Phồn Vinh
# Ảnh hồ sơ (nginx phục vụ /media/photos/, B-16)
# MEDIA_DIR=/data/media
# Cờ (kế hoạch GĐ B mục 11.2), mặc định là giá trị production:
# FEATURE_HOME_B=off  FEATURE_ACCOUNT_LINK=off  FEATURE_IDP_PUSH=off  FEATURE_PUBLIC_API=off
# FEATURE_CATALOG_FROM_DB=off  FEATURE_EXCLUSIONS_FROM_DB=off  FEATURE_IMPORT=on  RETENTION_MODE=dry_run
